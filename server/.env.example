# Upstream OpenAI-compatible endpoint. The agent's default "openai" provider
# reuses these, so the built-in agent works with no extra setup. This build runs
# on MiniMax (OpenAI-compatible). Set your own key at deploy time, never commit it.
OPENAI_BASE_URL=https://api.minimax.io/v1
OPENAI_API_KEY=
OPENAI_MODEL=MiniMax-M3

# HTTP + WebSocket port, and the bind address. Use HOST=127.0.0.1 behind a
# TLS reverse proxy so the port is not reachable directly.
PORT=8080
HOST=0.0.0.0

# Shared device token. Every /v1 and /sync client presents this as a Bearer token.
# The server refuses to start while this is the change-me placeholder. An empty
# value denies every client.
BOND_BEARER=change-me

# Comma-separated browser Origins allowed to open a sync WebSocket. A same-origin
# request (the bundled web build) and a non-browser client that sends no Origin
# are always allowed, so this only names extra cross-origin front ends. Empty is
# the common case.
ALLOWED_ORIGINS=

# Agent runtime. Which provider POST /v1/agent/turn uses when the request does
# not override it. "openai" reuses the endpoint above. "anthropic" needs the key.
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
# Optional model override for the agent loop. Empty falls back to a provider
# default (openai -> OPENAI_MODEL, anthropic -> a Claude default).
AGENT_MODEL=
# Ceiling on tool-calling steps per turn.
AGENT_MAX_STEPS=8

# The agent self-custodies a server-held keypair (a mobile wallet always prompts
# and cannot sign unattended). Base58 secret key or a JSON byte array. Empty
# generates an ephemeral keypair per process. Server-side only, never logged.
AGENT_SOLANA_SECRET=
# Solana RPC. Devnet by default so payment tools never touch mainnet funds.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet USDC mint the balance and transfer tools use.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional MCP skill server. When set, its tools load over StreamableHTTP and
# are exposed to the agent under the mcp_ namespace.
MCP_SKILL_URL=

# Android app link for the Mobile Wallet Adapter identity check. When both are set,
# /.well-known/assetlinks.json vouches that this origin belongs to the app signed with
# that key. Fingerprint as keytool prints it (SHA-256, colon-separated). Public values.
ANDROID_PACKAGE=com.zkasuran.bond
ANDROID_CERT_SHA256=
