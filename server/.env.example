# Upstream OpenAI-compatible endpoint. The agent's default "openai" provider
# reuses these, so the built-in agent works with no extra setup.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HTTP + WebSocket port.
PORT=8080

# Shared device token. Every /v1 and /sync client presents this as a Bearer token.
BOND_BEARER=change-me

# Agent runtime. Which provider POST /v1/agent/turn uses when the request does
# not override it. "openai" reuses the endpoint above. "anthropic" needs the key.
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
# Optional model override for the agent loop. Empty falls back to a provider
# default (openai -> OPENAI_MODEL, anthropic -> a Claude default).
AGENT_MODEL=
# Ceiling on tool-calling steps per turn.
AGENT_MAX_STEPS=8

# The agent self-custodies a server-held keypair (a mobile wallet always prompts
# and cannot sign unattended). Base58 secret key or a JSON byte array. Empty
# generates an ephemeral keypair per process. Server-side only, never logged.
AGENT_SOLANA_SECRET=
# Solana RPC. Devnet by default so payment tools never touch mainnet funds.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet USDC mint the balance and transfer tools use.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional MCP skill server. When set, its tools load over StreamableHTTP and
# are exposed to the agent under the mcp_ namespace.
MCP_SKILL_URL=
