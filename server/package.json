{
  "name": "bond-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bond own-gateway backend: OpenAI-compatible proxy, sync WebSocket and static web host.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.61",
    "@ai-sdk/openai": "4.0.73",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "ai": "7.0.112",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
